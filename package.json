{
  "name": "lumos-shooter",
  "version": "0.1.0",
  "private": true,
  "description": "Lumos Strike – browser 3D tactical shooter / battle royale (Three.js + Rapier), handheld & controller optimized.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:all": "concurrently -n web,server -c cyan,magenta \"vite --host\" \"npm run server\"",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets:process": "node scripts/process-assets.mjs",
    "assets:credits": "node scripts/build-credits.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@supabase/supabase-js": "^2.119.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.6",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "ws": "^8.18.0"
  }
}
