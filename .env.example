# Copy to .env.local – every variable is optional. Without any of them the game runs fully offline.

# --- Supabase (profiles, cloud saves, friends, match history) – see supabase/schema.sql
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# --- Lumos Cloud (primary backend inside Lumos OS / handhelds)
# VITE_LUMOS_API=https://cloud.lumos.example
# VITE_LUMOS_SESSION_TOKEN=dev-token
# VITE_LUMOS_CDN=https://cdn.lumos.example/lumos-strike/assets

# --- Realtime multiplayer relay (npm run server)
# VITE_REALTIME_URL=ws://localhost:8787
